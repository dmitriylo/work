          <td style="text-align: left;">M 3.1</td>
        </tr>
        <tr>
          <td style="text-align: left;">
            <em>RCNT<sub>12</sub> </em>
          </td>
          <td style="text-align: left;">Общее количество восстановительных команд</td>
