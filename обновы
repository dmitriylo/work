                    <td>
                      <p>Инициатор</p>
                    </td>
                    <td>
                      <p>
                        <span style="color: rgb(75,85,99);text-decoration: none;">
                          <span style="color: rgb(22,22,22);">
                            <span style="color: rgb(75,85,99);text-decoration: none;">
                              <span style="color: rgb(22,22,22);">1.4 Провести анализ запроса</span>
                            </span>
                          </span>
                        </span>
                      </p>
                      <p>
                        <span style="color: rgb(75,85,99);">и</span>
                      </p>
                      <p>
                        <span style="color: rgb(75,85,99);text-decoration: none;">
                          <span style="color: rgb(22,22,22);">
                            <span style="color: rgb(75,85,99);text-decoration: none;">
                              <span style="color: rgb(22,22,22);">2.1 Приступить к выполнению плана работ</span>
                            </span>
                          </span>
                        </span>
                      </p>
                      <p>
                        <span style="color: rgb(75,85,99);text-decoration: none;">
                          <span style="color: rgb(22,22,22);">или</span>
                        </span>
                      </p>
                      <p>
                        <span style="color: rgb(75,85,99);text-decoration: none;">
                          <span style="color: rgb(22,22,22);">1.2 Составить план обновления ПО</span>
                        </span>
                      </p>
