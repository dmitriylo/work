            <tbody class="">
              <tr class="">
                <td>
                  <p>Критичность<br/>ИТ-актива</p>
                  <p>
                    <br/>
                  </p>
                  <p>(Оценка<br/>по CVSS v.3.1)</p>
                </td>
                <td>
                  <p>Высокая</p>
                </td>
                <td>
                  <p>Средняя</p>
                </td>
